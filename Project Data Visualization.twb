      </column>
      <column caption='Gempa Bumi Tsunami' datatype='integer' name='[Calculation_296111685742518277]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([tsunami] = 1, 1, 0))' />
